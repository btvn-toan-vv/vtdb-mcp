{
  "uid": "vtdb-mcp-logs",
  "title": "vtdb-mcp · Logs",
  "description": "Pod logs collected by Grafana Alloy into Loki. The server's plain log format is parsed into level labels and logger structured metadata.",
  "tags": ["vtdb-mcp", "loki", "alloy"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by level",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": { "mode": "normal" }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "DEBUG": { "color": "blue" },
                "INFO": { "color": "green" },
                "WARNING": { "color": "orange" },
                "ERROR": { "color": "red" },
                "CRITICAL": { "color": "purple" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (count_over_time({app=\"vtdb-mcp\"}[$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "vtdb-mcp server logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 8 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"vtdb-mcp\", service=\"server\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
